% Experiment 11: Linearity and Time Invariance

clc;
clear;
close all;

% Define Time Parameters
t = -1:0.001:1;
t0 = 0.2;

% Generate Input Signals
x1 = sin(2*pi*5*t);
x2 = cos(2*pi*5*t);

% Define Constants
a = 2;
b = 3;

% Define the System
T = @(x) 2*x;

% Test Linearity
lhs = T(a*x1 + b*x2);
rhs = a*T(x1) + b*T(x2);

linError = max(abs(lhs - rhs));

% Test Time Invariance
xDelay = sin(2*pi*5*(t - t0));

lhsTI = T(xDelay);
rhsTI = T(x1);

rhsTIshift = interp1(t, rhsTI, t - t0, 'linear', 0);

tiError = max(abs(lhsTI - rhsTIshift));

% Plot the Errors
figure;

subplot(2,1,1);
plot(t, lhs - rhs);
grid on;
title('Linearity Error');
xlabel('Time (s)');
ylabel('Error');

subplot(2,1,2);
plot(t, lhsTI - rhsTIshift);
grid on;
title('Time-Invariance Error');
xlabel('Time (s)');
ylabel('Error');

% Display Results
fprintf('Linearity error = %g\n', linError);
fprintf('Time-invariance error = %g\n', tiError);
