% Experiment 3: Energy and Power Analysis

clc;
clear;
close all;

% Define Time Parameters
dt = 0.001;
t = 0:dt:5;

% Generate Signals
xE = exp(-t);
xP = sin(2*pi*5*t);

% Calculate Energy of the Energy Signal
E_num = trapz(t, abs(xE).^2);

% Calculate Average Power of the Periodic Signal
T0 = 1/5;
T = 2;
idx = t <= T;

P_num = (1/T) * trapz(t(idx), abs(xP(idx)).^2);

% Plot the Signals
figure;

subplot(2,1,1);
plot(t, xE);
grid on;
title('Energy Signal e^{-t}u(t)');
xlabel('Time (s)');
ylabel('Amplitude');

subplot(2,1,2);
plot(t, xP);
grid on;
title('Power Signal sin(2\pi5t)');
xlabel('Time (s)');
ylabel('Amplitude');

% Display Results
fprintf('Numerical energy = %g\n', E_num);
fprintf('Numerical average power = %g\n', P_num);
