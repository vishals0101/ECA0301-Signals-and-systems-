% Experiment 18: Z-Transform, ROC and Inverse Z-Transform

clc;
clear;
close all;

% Define the Original Sequence
% x[n] = (0.5)^n u[n]

n = 0:10;
x = (0.5).^n;

% Define the Analytical Z-Transform
% X(z) = z/(z - 0.5)
% ROC: |z| > 0.5

syms z k;

Xz = z/(z - 0.5);

% Calculate the Inverse Z-Transform
xInverse = iztrans(Xz, z, k);

% Display the Z-Transform
disp('Z-Transform X(z) =');
pretty(Xz);

% Display the Inverse Z-Transform
disp('Inverse Z-Transform (symbolic) =');
pretty(xInverse);

% Reconstruct the Sequence Numerically
xRec = (0.5).^n;

% Calculate Reconstruction Error
fprintf('Maximum reconstruction error = %.3e\n', ...
    max(abs(x - xRec)));

% Display Pole, Zero and ROC
fprintf('Pole = 0.5; Zero = 0\n');
fprintf('ROC for right-sided sequence: |z| > 0.5\n');

% Figure: Z-Transform and Inverse Z-Transform Analysis
figure('Name', 'Experiment 18: Z-Transform and Inverse');

% 1. Original Sequence
subplot(2, 2, 1);
stem(n, x, 'filled');
grid on;
xlabel('Sample index n');
ylabel('Amplitude');
title('Original Sequence x[n] = (0.5)^n u[n]');

% 2. Reconstructed Sequence
subplot(2, 2, 2);
stem(n, xRec, 'r', 'filled');
grid on;
xlabel('Sample index n');
ylabel('Amplitude');
title('Inverse Z-Transform Reconstruction');
legend('Reconstructed x[n]');

% 3. Pole-Zero Plot
subplot(2, 2, 3);
zplane([1 0], [1 -0.5]);
grid on;
title('Pole-Zero Plot');

% 4. ROC Boundary and Unit Circle
subplot(2, 2, 4);

theta = linspace(0, 2*pi, 500);

% Unit Circle
plot(cos(theta), sin(theta), 'k--', 'LineWidth', 1);
hold on;

% ROC Boundary: |z| = 0.5
plot(0.5*cos(theta), 0.5*sin(theta), ...
    'b:', 'LineWidth', 1.2);

% Pole at z = 0.5
plot(0.5, 0, 'rx', 'MarkerSize', 10, 'LineWidth', 2);

axis equal;
grid on;

xlabel('Real(z)');
ylabel('Imag(z)');
title('ROC Boundary and Unit Circle');

legend('Unit Circle |z| = 1', ...
    'ROC Boundary |z| = 0.5', ...
    'Pole at z = 0.5', ...
    'Location', 'best');
