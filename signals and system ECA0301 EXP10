% Experiment 10: Zero-Input, Zero-State, Impulse Response and Convolution
% System: dy(t)/dt + 2y(t) = x(t)

clc;
clear;
close all;

% Define the Transfer Function
num = [1];
den = [1 2];
sys = tf(num, den);

% Display the Transfer Function and Pole
disp('Transfer Function:');
sys

disp('Pole:');
disp(pole(sys));

% Define the Time Range
t = 0:0.01:5;
dt = t(2) - t(1);

% Define the Impulse Response
h = exp(-2*t);

% Define the Unit-Step Input
x_step = ones(size(t));

% 1. Impulse Response
figure;
impulse(sys, t);
grid on;
title('Impulse Response h(t)');
xlabel('Time (s)');
ylabel('h(t)');

% 2. Zero-Input Response: y(0-) = 1, x(t) = 0
y_zi = exp(-2*t);

figure;
plot(t, y_zi, 'LineWidth', 1.5);
grid on;
title('Zero-Input Response');
xlabel('Time (s)');
ylabel('y_{zi}(t)');

% 3. Zero-State Response to Unit-Step Input
[y_zs, tout] = step(sys, t);
y_zs = squeeze(y_zs);

figure;
plot(tout, y_zs, 'LineWidth', 1.5);
grid on;
title('Zero-State Response to Unit Step');
xlabel('Time (s)');
ylabel('y_{zs}(t)');

% 4. Numerical Convolution
% y_zs(t) = integral from 0 to t of x(tau)h(t-tau) d(tau)

y_conv_full = conv(x_step, h) * dt;
y_conv = y_conv_full(1:length(t));

% Trapezoidal Endpoint Correction
y_conv = y_conv - 0.5*dt*(x_step(1)*h + x_step.*h(1));

% 5. Calculate Total Response
y_total = y_zi + y_zs(:).';

figure;
plot(t, y_zi, t, y_zs(:).', t, y_total, 'LineWidth', 1.3);
grid on;
legend('Zero-input', 'Zero-state', 'Total response', ...
    'Location', 'best');
title('Comparison of Response Components');
xlabel('Time (s)');
ylabel('Response');

% 6. Verify Convolution Using lsim
y_lsim = lsim(sys, x_step, t);

figure;
plot(t, y_conv, '--', t, y_lsim(:).', '-');
grid on;
legend('Convolution approximation', 'lsim zero-state response', ...
    'Location', 'best');
title('Convolution Verification');
xlabel('Time (s)');
ylabel('y_{zs}(t)');
