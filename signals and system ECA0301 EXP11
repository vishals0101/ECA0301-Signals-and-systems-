% Experiment: Sampling Theorem and Signal Reconstruction

clc;
clear;
close all;

% Define Signal Parameters
fm = 50;          % Message signal frequency (Hz)
T = 0.06;         % Observation time (seconds)
dt = 1e-5;        % Fine time step

% Generate Continuous-Time Signal
t = 0:dt:T;
x = cos(2*pi*fm*t);

% Define Different Sampling Frequencies
fs_list = [0.5*fm, fm, 2*fm, 5*fm, 10*fm];

% Labels for Plots
labels = {'fs = 0.5 fm (Aliased)', ...
          'fs = fm (Under-sampled)', ...
          'fs = 2 fm (Nyquist Rate)', ...
          'fs = 5 fm (Over-sampled)', ...
          'fs = 10 fm (Over-sampled)'};

% Plot Sampling at Different Rates
figure('Name', 'Sampling at Different Rates');

for k = 1:length(fs_list)

    fs = fs_list(k);
    n = 0:1/fs:T;
    xn = cos(2*pi*fm*n);

    subplot(length(fs_list), 1, k);
    plot(t, x, 'b-', 'LineWidth', 1);
    hold on;
    stem(n, xn, 'r', 'filled');

    title(labels{k});
    xlabel('Time (s)');
    ylabel('x(t)');
    grid on;

end

% Reconstruction Using Ideal Sinc Interpolation
% Calculate Reconstruction Error for Each Sampling Rate

fprintf('Nyquist rate (2*fm) = %.2f Hz\n', 2*fm);

err = zeros(size(fs_list));

for k = 1:length(fs_list)

    fs = fs_list(k);
    n = 0:1/fs:T;
    xn = cos(2*pi*fm*n);

    x_recon = zeros(size(t));

    for i = 1:length(n)
        x_recon = x_recon + xn(i)*sinc(fs*(t - n(i)));
    end

    err(k) = mean(abs(x - x_recon));

    fprintf(['fs = %6.1f Hz (fs/fm = %4.1f) ', ...
             '-> Mean reconstruction error = %.5f\n'], ...
             fs, fs/fm, err(k));

end

% Reconstruct Signal at fs = 10*fm
fs = 10*fm;
n = 0:1/fs:T;
xn = cos(2*pi*fm*n);

x_recon = zeros(size(t));

for i = 1:length(n)
    x_recon = x_recon + xn(i)*sinc(fs*(t - n(i)));
end

% Plot Original and Reconstructed Signals
figure('Name', 'Reconstruction at fs = 10 fm');

plot(t, x, 'b', 'LineWidth', 1.5);
hold on;
plot(t, x_recon, 'r--', 'LineWidth', 1.2);

legend('Original x(t)', 'Reconstructed x(t)');
title('Sinc-Interpolated Reconstruction');
xlabel('Time (s)');
ylabel('Amplitude');
grid on;

% Plot Reconstruction Error
figure('Name', 'Reconstruction Error vs Sampling Ratio');

semilogy(fs_list/fm, err, '-o', 'LineWidth', 1.5);
grid on;

xlabel('f_s / f_m');
ylabel('Mean Reconstruction Error (Log Scale)');
title('Reconstruction Error vs Sampling-to-Signal Frequency Ratio');
