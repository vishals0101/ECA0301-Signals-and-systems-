% Experiment 2(ii): Time Shifting and Time Reversal

clc;
clear;
close all;

% Step 1: Define the time axis
t = -1:0.001:1;

% Step 2: Define the time shift
t0 = 0.2;

% Step 3: Generate the original signal
x = sin(2*pi*5*t);

% Step 4: Perform time shifting (delay)
xShift = sin(2*pi*5*(t-t0));

% Step 5: Perform time reversal
xRev = sin(2*pi*5*(-t));

% Step 6: Plot all signals
figure;

% Original Signal
subplot(3,1,1);
plot(t,x);
grid on;
title('Original Signal x(t)');
xlabel('Time (s)');
ylabel('Amplitude');

% Time Shifted Signal
subplot(3,1,2);
plot(t,xShift);
grid on;
title('Time Shifted Signal x(t-t0)');
xlabel('Time (s)');
ylabel('Amplitude');

% Time Reversed Signal
subplot(3,1,3);
plot(t,xRev);
grid on;
title('Time Reversed Signal x(-t)');
xlabel('Time (s)');
ylabel('Amplitude');
