
% Experiment 5(i): Analysis of Fourier Series Representation
% of Continuous-Time Periodic Signals

clc;
clear;
close all;

% Define Signal Parameters
A = 1;
f0 = 1;
T = 1/f0;
t = linspace(0, 2*T, 2000);

% Generate Half-Wave Rectified Sinusoidal Signal
x = A * sin(2*pi*f0*t);
x(x < 0) = 0;

% Number of Fourier Series Harmonics
N = 10;

% Calculate Fourier Series Coefficients
a0 = (1/T) * trapz(t, x) / 2;
an = zeros(1, N);
bn = zeros(1, N);

for k = 1:N
    an(k) = (1/T) * trapz(t, x .* cos(2*pi*k*f0*t));
    bn(k) = (1/T) * trapz(t, x .* sin(2*pi*k*f0*t));
end

% Reconstruct Signal Using Fourier Series
xFS = a0 * ones(size(t));

for k = 1:N
    xFS = xFS + an(k) * cos(2*pi*k*f0*t) ...
              + bn(k) * sin(2*pi*k*f0*t);
end

% Plot Original and Reconstructed Signals
figure;

plot(t, x, 'k', 'LineWidth', 1.2);
hold on;
plot(t, xFS, 'r--', 'LineWidth', 1.2);

grid on;
xlabel('Time (s)');
ylabel('Amplitude');
title('Fourier Series Representation of a Periodic Signal');
legend('Original Signal', 'Fourier Series Reconstruction');
